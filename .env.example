# ==============================================================================
# CHRONO - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Gemini API Key (Recommended for Chrono Agent)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Optional: OpenAI or Groq API Key
OPENAI_API_KEY=""
GROQ_API_KEY=""

# Database (Default: SQLite local dev.db)
DATABASE_URL="file:./dev.db"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_JWKS_URL=""

# Optional: Cloudflare R2 / AWS S3 for Image Storage
R2_BUCKET_NAME=""
R2_PUBLIC_DOMAIN=""

# Email Delivery (Workspace Invitations, Password Recovery & Notifications)
# Configure SMTP credentials from your email service provider (e.g. Resend, SendGrid, Amazon SES, or custom SMTP)
SMTP_HOST="" # SMTP server hostname
SMTP_PORT="" # SMTP server port (typically 465 for SSL or 587 for TLS)
SMTP_USER="" # SMTP username or API key identifier
SMTP_PASS="" # SMTP password or secret API token
SMTP_FROM="" # Sender identity in standard format: Name <email@yourdomain.com>

